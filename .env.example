# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
TELEGRAM_ADMIN_ID=123456789
ADMIN_NOTIFY_QUERIES=1
WEBHOOK_SECRET=your_telegram_webhook_secret_token_here
WEBHOOK_HOST=your-app.domain.com

# Database Configuration (PostgreSQL with asyncpg)
# Format: postgresql+asyncpg://user:password@host:port/dbname
LOD_DATABASE_URL=postgresql+asyncpg://user:password@ep-example.neon.tech/loglan_db?sslmode=require
SQL_REQUESTS_ECHO=0

# Application Preferences
DEFAULT_STYLE=ultra
DEFAULT_SEARCH_LANGUAGE=log
DEFAULT_HTML_STYLE=normal
